# syntax=docker/dockerfile:1

FROM golang:1.24-bookworm AS build
# go.mod may require a newer toolchain than the image tag.
ENV GOTOOLCHAIN=auto
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /kmc-controller ./cmd/kmc-controller

FROM gcr.io/distroless/static:nonroot
COPY --from=build /kmc-controller /kmc-controller
USER nonroot:nonroot
ENTRYPOINT ["/kmc-controller"]
