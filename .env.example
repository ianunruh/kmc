# Copy to .env and fill in values:
#   cp .env.example .env
#
# Default local mode needs nothing set (kubeconfig).
# For multi-user impersonation, set KMC_AUTH_MODE=impersonate and the vars below.

# kubeconfig | impersonate
KMC_AUTH_MODE=kubeconfig

# Required when using sessions / GitHub login (min 32 chars)
#   openssl rand -hex 32
KMC_SESSION_SECRET=

# GitHub OAuth App (https://github.com/settings/developers)
# Homepage:  http://localhost:5173
# Callback:  http://localhost:5173/auth/callback
KMC_GITHUB_CLIENT_ID=
KMC_GITHUB_CLIENT_SECRET=

# Comma-separated orgs whose teams map to k8s groups oidc:<org>:<team>
KMC_GITHUB_ORGS=kcloud-ops

# Must match the OAuth App callback origin
KMC_PUBLIC_URL=http://localhost:5173

# Optional
# KMC_CLUSTERS_CONFIG=config/clusters.yaml
# KMC_CONTEXTS=prod-sjc1,homelab
# KMC_IMAGE_NAMESPACE=vm-images
# KMC_SESSION_TTL_SECONDS=43200
# KMC_USERNAME_PREFIX=oidc:
# KMC_GROUPS_PREFIX=oidc:
